# Frontend environment variables — copy to .env.local and fill in your values
#
# LOCAL DEVELOPMENT ONLY:
# Set this to point directly at the local backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# PRODUCTION (Railway):
# Do NOT set NEXT_PUBLIC_API_URL in Railway.
# Instead set BACKEND_URL (server-side only) — the /api rewrite in next.config.js
# proxies all browser /api/* requests to the backend server-side, avoiding
# mixed-content errors and CORS entirely.
#
# BACKEND_URL=https://your-backend.up.railway.app   ← set this in Railway frontend service
#
# Sentry error monitoring (optional in dev, recommended in production).
# Set NEXT_PUBLIC_SENTRY_DSN for client-side error reporting.
# Set SENTRY_DSN (server-side) if it differs from the public DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
#
# Sentry source-map upload (only needed for production releases).
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=...
# SENTRY_PROJECT=...
#
# WARNING: If you do set NEXT_PUBLIC_API_URL in production, it MUST use https://
# not http:// — otherwise the browser will block it as mixed content ("Failed to fetch").
